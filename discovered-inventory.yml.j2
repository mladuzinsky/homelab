---
# Auto-generated by playbooks/discover_hosts.yml
# Network: {{ network_cidr }}
# Generated: {{ generated_at }}
#
# Review these hosts, then copy anything you want to keep into inventory/hosts.yml.
# This file is overwritten on every discovery run.

all:
  children:
{% if unique_hosts | length == 0 %}
    unclassified:
      hosts: {}
{% else %}
{% for os_key in unique_hosts | map(attribute='os_key') | unique | list | sort %}
    {{ os_key }}:
      hosts:
{% for host in unique_hosts | selectattr('os_key', 'equalto', os_key) | list | sort(attribute='inventory_name') %}
        {{ host.inventory_name }}:
          ansible_host: {{ host.ip }}
          ansible_user: {{ host.user }}
{% if host.distribution %}
          discovered_distribution: "{{ host.distribution }}"
{% endif %}
{% if host.version %}
          discovered_distribution_version: "{{ host.version }}"
{% endif %}
{% if host.os_family %}
          discovered_os_family: "{{ host.os_family }}"
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
