#cloud-config
hostname: {{ vm_name }}
fqdn: {{ vm_name }}.lan
manage_etc_hosts: true

users:
  - name: {{ vm_admin_user }}
    gecos: Fedora admin
    groups: [wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    passwd: {{ admin_password_hash.stdout }}
{% if vm_ssh_pubkey | length > 0 %}
    ssh_authorized_keys:
      - {{ vm_ssh_pubkey }}
{% endif %}

chpasswd:
  expire: {{ 'true' if vm_expire_password | bool else 'false' }}

ssh_pwauth: true
disable_root: true

package_update: true
packages:
  - qemu-guest-agent
  - qemu-guest-agent-selinux

runcmd:
  - systemctl enable --now qemu-guest-agent
  - growpart /dev/sda 1 || true
  - xfs_growfs / || true
